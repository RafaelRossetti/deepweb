# Copie para .env; não faça commit de .env nem de PDFs ou dados reais.
# Senha para abrir atividades como professor. Use uma senha própria.
TEACHER_PASSWORD=troque-por-uma-senha-do-professor

# Teste local: Node.js 24 e npm start. Sem Supabase, grava em .data.
PORT=3000
# THOR_DATA_DIR=C:/Projetos/deepweb/.data

# Publicação na Vercel: preencha as duas variáveis SOMENTE no servidor.
# Use a URL base do projeto dedicado e uma secret key sb_secret_...
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Compatibilidade temporária: SUPABASE_SERVICE_ROLE_KEY (JWT com role service_role).
# Não use anon, publishable, NEXT_PUBLIC_ ou VITE_ para estas credenciais.
